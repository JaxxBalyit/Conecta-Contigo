---
import Layout from '../layouts/Layout.astro';

const referencias = [
  { titulo: "Estrés Laboral", url: "https://www.imss.gob.mx/sites/all/statics/salud/estreslaboral/Test-Estres-Laboral.pdf" },
  { titulo: "Satisfacción Laboral", url: "https://www.imss.gob.mx/sites/all/statics/salud/estreslaboral/Test-Satisfaccion-Laboral.pdf" },
  { titulo: "Síndrome del burnout", url: "https://calidad.salud.gob.mx/site/has/autotest-burnout.html"}
];
---
<Layout title="Conecta Contigo - Test">
  <section class="space-y-4">
    <h2 class="text-lg font-bold text-brand">Referencias</h2>
    <ul class="space-y-2">
      {referencias.map(ref => (
        <li>
          <a href={ref.url} target="_blank" rel="noopener noreferrer"
             class="block bg-brand/10 border border-brand/30 rounded-xl p-3 text-sm text-brand underline">
            {ref.titulo}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
